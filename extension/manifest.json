{
  "manifest_version": 3,
  "name": "Sip — Water Log",
  "version": "1.0.0",
  "description": "Log every glass of water with a keypress and review a timestamped daily breakdown.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Sip — log water",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/keys.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Open Sip"
    },
    "log-glass": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Log your default glass"
    },
    "undo-last": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Undo the last glass"
    }
  }
}
